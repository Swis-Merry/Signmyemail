# Leave empty locally to use an embedded PGlite database in ./.data
DATABASE_URL=
# Random 32+ char string used to sign session cookies
AUTH_SECRET=
# First admin account, created automatically if no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Public URL of the deployment (used for image links inside signatures)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=SignStudio
# Google Workspace push (service account JSON, raw or base64) and domain
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_DOMAIN=drehomes.com
# Per-employee Gmail install without a Workspace admin: Google OAuth "Web application" client
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/public/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
